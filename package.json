  "main": "index.js",
  "scripts": {
    "build": "shx rm -rf build && .\\node_modules\\.bin\\tsc",
    "start": "cross-env NODE_ENV=production node build\\index.js",
    "dev": "concurrently -p name -c \"yellow,blue\" -n \"tsc,nodemon\" \"npm run dev:tsc\" \"npm run dev:nodemon\"",
    "dev:tsc": "shx rm -rf build && .\\node_modules\\.bin\\tsc --watch",
    "dev:nodemon": "wait-on -l build\\index.js && nodemon -q build\\index.js\"",
    "docker:build": "./node_modules/.bin/tsc -p tsconfig.json"
  },
